{
  "rules": {
    "live_locations": {
      "$device_id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "user_devices": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pairings": {
      "$owner_device_id": {
        ".read": "auth != null",
        "$paired_device_id": {
          ".write": "auth != null"
        }
      }
    }
  }
}
